<configuration>

    <appender name = "myConsoleAppender" class = "ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>
<!--           date time format  thread name   -5 means left justified with 5 char len    {36} means 36 char used for logger namer     %n for new line -->
                %d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n
            </pattern>
        </encoder>
    </appender>

    <appender name = "myFileAppender" class="ch.qos.logback.core.FileAppender">
        <file>
<!--            specify file path with name-->
            journalApp.log
        </file>
        <encoder>
            <pattern>
                %d{yy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n
            </pattern>
        </encoder>
    </appender>

    <appender name = "myRollingFileAppender" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>
            <!--            specify file path with name-->
            journalAppRollOver.log
        </file>

        <rollingPolicy class = "ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>
<!--                file name will include date time for older log files, latest file will be journalAppRollover.log, %i is for index-->
                journalApp-%d{yy-MM-dd_HH-mm}.%i.log
            </fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
<!--            max 10 log files will be kept, oldest will be deleted-->
            <maxHistory>10</maxHistory>
        </rollingPolicy>
        <encoder>

            <pattern>
                %d{yy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n
            </pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref = "myConsoleAppender" />
        <appender-ref ref = "myRollingFileAppender" />
    </root>


</configuration>